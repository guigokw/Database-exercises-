-- Liste todos os alunos de um determinado plano
select * from alunos
where (informacoes_adicionais).plano_aluno = 'básico';

-- Calcule a média de duração dos treinos por especialidade do instrutor.
select instrutores.especialidade_instrutor, avg((detalhes_treino).duracao_em_minutos) as media_duracao_treino
from instrutores inner join treinos on instrutores.id_instrutor = treinos.id_instrutor
group by instrutores.especialidade_instrutor

-- Liste os instrutores e a quantidade de treinos que cada um realizou
select instrutores.nome_instrutor, count(treinos.id_treino) as treinos_realizados
from instrutores inner join treinos on instrutores.id_instrutor = treinos.id_instrutor
group by instrutores.nome_instrutor;

-- Treinos Realizados por Instrutor em um Período Específico
select instrutores.nome_instrutor, treinos.data_treino, (detalhes_treino).descricao_treino
from instrutores inner join treinos on instrutores.id_instrutor = treinos.id_instrutor
where treinos.data_treino between '2024-12-10' and '2024-12-14'
order by treinos.data_treino;

-- Média de Duração dos Treinos por Plano do Aluno
select (informacoes_adicionais).plano_aluno, avg((detalhes_treino).duracao_em_minutos) as media_de_tempo_de_treino
from alunos inner join treinos on alunos.id_aluno = treinos.id_aluno
group by (informacoes_adicionais).plano_aluno;

-- Treinos Mais Longos por Especialidade
select instrutores.especialidade_instrutor, max((detalhes_treino).duracao_em_minutos) as treinos_mais_longos
from instrutores inner join treinos on instrutores.id_instrutor = treinos.id_instrutor
group by instrutores.especialidade_instrutor;

-- Total de Minutos de Treino por Aluno
select alunos.nome_aluno, sum((detalhes_treino).duracao_em_minutos) as total_de_minutos_de_treino
from alunos inner join treinos on alunos.id_aluno = treinos.id_aluno
group by alunos.nome_aluno;

-- Instrutores com Mais de 2 Treinos Realizados
select instrutores.nome_instrutor, count(treinos.id_treino) as treinos_realizados
from instrutores inner join treinos on instrutores.id_instrutor = treinos.id_instrutor
group by instrutores.nome_instrutor
having count(treinos.id_treino) > 2;

--  Treinos com Duração Acima da Média
select treinos.data_treino, (detalhes_treino).descricao_treino, sum((detalhes_treino).duracao_em_minutos) as duracao_treino
from treinos
group by treinos.data_treino, (detalhes_treino).descricao_treino
having sum((detalhes_treino).duracao_em_minutos) > (
                   select avg((detalhes_treino).duracao_em_minutos)
				   from treinos);

select avg((detalhes_treino).duracao_em_minutos)
from treinos;

-- Alunos que Fizeram Treinos com Instrutores de Especialidade Diferente
select alunos.nome_aluno, count(distinct treinos.id_instrutor) as treinos_com_instrutores_diferentes
from alunos inner join treinos on alunos.id_aluno = treinos.id_aluno
group by alunos.nome_aluno
having count(distinct treinos.id_instrutor) > 1;

-- Dias com Maior Número de Treinos
select treinos.data_treino, count(treinos.id_treino) as treinos_feitos_no_dia from treinos
group by treinos.data_treino
having count(treinos.id_treino) > 1
order by count(treinos.id_treino) desc

--  Alunos que Fizeram Treinos com um Instrutor Específico
select alunos.nome_aluno, treinos.data_treino, (detalhes_treino).descricao_treino
from alunos inner join treinos on alunos.id_aluno = treinos.id_aluno
inner join instrutores on treinos.id_instrutor = instrutores.id_instrutor
where instrutores.nome_instrutor like 'mar%';

-- Total de Treinos por Especialidade e Plano do Aluno
select instrutores.especialidade_instrutor, (informacoes_adicionais).plano_aluno, count(treinos.id_treino) as treinos_realizados
from alunos inner join treinos on alunos.id_aluno = treinos.id_aluno
inner join instrutores on treinos.id_instrutor = instrutores.id_instrutor
group by instrutores.especialidade_instrutor, (informacoes_adicionais).plano_aluno
