create database academia;

create type plano as enum('básico', 'intermediario', 'avancado');

create type especialidade as enum('musculacao', 'crossfit', 'yoga', 'pilates');

create domain data_inicio_plano as date
check (value between '2018-05-15' and current_date); -- o valor esta entre o dia da criação da academia e o dia atual

create domain telefone as varchar(11)
check (length(value) = 11 and value ~ '^[0-9]+$');

create type informacoes_adicionais as (
plano_aluno plano,
data_inicio_plano data_inicio_plano
);

create type detalhes_treino as (
duracao_em_minutos smallint,
descricao_treino text
);

create table alunos (
id_aluno serial unique primary key,
nome_aluno varchar(200) not null,
data_nascimento_aluno date,
informacoes_adicionais informacoes_adicionais
);


create table instrutores (
id_instrutor serial unique primary key,
nome_instrutuor varchar(200) not null,
especialidade_instrutor especialidade,
telefone_instrutor telefone
);

ALTER TABLE instrutores RENAME COLUMN nome_instrutuor TO nome_instrutor;

create table treinos (
id_treino serial unique primary key,
id_aluno int references alunos(id_aluno),
id_instrutor int references instrutores(id_instrutor),
data_treino date,
detalhes_treino detalhes_treino
);

