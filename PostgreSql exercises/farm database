-- função que retorne a produção total de leite de um animal em um período 
create or replace function calcular_producao_leite(animal_id int, data_inicio date, data_fim date)
returns int as $$
declare
leite_total int;
animal_tipo tipo_animal;
sexo sexo_animal;
begin

select tipo_animal, sexo_animal into animal_tipo, sexo
from animal where id_animal = animal_id;

if (animal_tipo = 'SUINO' or animal_tipo = 'AVES') then
    raise exception 'não foi possivel calcular a produção de leite, pois o animal fornecido é um suino ou uma ave';
end if;

if (sexo = 'MACHO') then
    raise exception 'não foi possivel calcular a producao de leite do animal fornecido pois ele é macho';
end if;

select sum(quantidade_litros) into leite_total
from producao_leite
where id_animal = animal_id
and producao_leite.data_producao_leite between data_inicio and data_fim;

return leite_total;
end;
$$ language plpgsql;

select calcular_producao_leite(2, '2024-04-24', current_date);

-- uma função que, dado um tipo de plantação, retorne a estimativa de colheita baseada na área e produtividade média
create or replace function estimativa_colheita(plantacao_id int)
returns numeric(10,2) as $$
declare
plantacao_tipo tipo_plantacao;
area int;
kg_media int;
begin
select plantacao.tipo_plantacao, plantacao.area_hectares, avg(producao_graos.quantidade_kg)
into plantacao_tipo, area, kg_media
from plantacao left join producao_graos on plantacao.id_plantacao = producao_graos.id_plantacao
where plantacao.id_plantacao = plantacao_id
group by plantacao.tipo_plantacao, plantacao.area_hectares;

case
  when (plantacao_tipo = 'SOJA') then
    if (area between 0 and 3) then
	   if (kg_media < 60) then
	     return 54.5;
	    elsif (kg_media < 120) then
		 return 71.2;
		else 
		 return 99.87;
	    end if;
	elsif (area < 12) then
	  if (kg_media < 150) then
	    return 124.94;
	  elsif (kg_media < 220) then
	    return 181.1;
	  else
	    return 224;
	  end if;
	else
	   if (kg_media < 250) then
	    return 238.94;
	  elsif (kg_media < 310) then
	    return 291.1;
	  else
	    return 360;
	  end if;
	end if;
  when (plantacao_tipo = 'MILHO') then
    if (area between 0 and 3) then
	   if (kg_media < 60) then
	     return 41.80;
	    elsif (kg_media < 105) then
		 return 81.2;
		else 
		 return 109.87;
	    end if;
	elsif (area < 12) then
	  if (kg_media < 165) then
	    return 138.96;
	  elsif (kg_media < 220) then
	    return 194.12;
	  else
	    return 251;
	  end if;
	else
	   if (kg_media < 280) then
	    return 256.94;
	  elsif (kg_media < 325) then
	    return 301.1;
	  else
	    return 335;
	  end if;
	end if;
  when (plantacao_tipo = 'TRIGO') then
    if (area between 0 and 3) then
	   if (kg_media < 60) then
	     return 42.5;
	    elsif (kg_media < 120) then
		 return 77.2;
		else 
		 return 131.87;
	    end if;
	elsif (area < 12) then
	  if (kg_media < 125) then
	    return 101.94;
	  elsif (kg_media < 180) then
	    return 151.1;
	  else
	    return 203;
	  end if;
	else
	   if (kg_media < 210) then
	    return 178.94;
	  elsif (kg_media < 280) then
	    return 261.1;
	  else
	    return 305;
	  end if;
	end if;
  when (plantacao_tipo = 'CAFÉ') then
    if (area between 0 and 3) then
	   if (kg_media < 60) then
	     return 50.5;
	    elsif (kg_media < 120) then
		 return 84.2;
		else 
		 return 126.87;
	    end if;
	elsif (area < 12) then
	  if (kg_media < 180) then
	    return 144.94;
	  elsif (kg_media < 235) then
	    return 200.1;
	  else
	    return 241;
	  end if;
	else
	   if (kg_media < 260) then
	    return 248.94;
	  elsif (kg_media < 320) then
	    return 301.1;
	  else
	    return 370;
	  end if;
	end if;	
  else
    raise exception 'tipo de plantacao invalido';
end case;
end;
$$ language plpgsql;

