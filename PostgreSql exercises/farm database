create database fazenda;

create type tipo_animal as enum('BOVINO', 'EQUINO', 'SUINO', 'OVINOS', 'CAPRINOS', 'AVES');

create type tipo_plantacao as enum('SOJA', 'MILHO', 'TRIGO', 'CAFÉ');

create type sexo_animal as enum('MACHO', 'FÊMEA');

create type tipo_equipamento as enum('MAQUINARIO AGRICOLA', 'FERRAMENTA MANUAL');

create type cargo_funcionario as enum('AGRICULTOR', 'PECUARISTA', 'OPERADOR DE MAQUINAS', 'ENGENHEIRO AGRONOMO', 'GERENTE DE FAZENDA');

create type tipo_manutencao as enum('PREVENTIVA', 'CORRETIVA', 'PREDICTIVA');

create type status_manutencao as enum('CONCLUIDA', 'PENDENTE', 'CANCELADA');

create type tipo_racao as enum('PROTEICA', 'ENERGETICA', 'MINERAL', 'FIBROSA');

create domain percentual_fazenda smallint
check (value between 0 and 100);

create domain peso_animal numeric(5,2)
check (value between 3 and 510.00) 

create domain quantidade_positiva int
check (value > 0);

create type localizacao_fazenda as (
latitude point,
longitude point
);

create table animal (
id_animal serial primary key,
nome_animal varchar(150),
tipo_animal tipo_animal,
data_nascimento date,
sexo_animal sexo_animal,
peso_animal peso_animal
);

create table plantacao (
id_plantacao serial primary key,
tipo_plantacao tipo_plantacao,
area_hectares int,
data_plantio date,
coordenadas_local point
);

create table equipamento (
id_equipamento serial primary key,
nome_equipamento varchar(150),
tipo_equipamento tipo_equipamento,
data_aquisicao date,
valor numeric(10,2),
vida_util_anos smallint
);

create table funcionario_fazenda (
id_funcionario serial primary key,
nome_funcionario varchar(150),
cargo_funcionario cargo_funcionario,
salario numeric(6,2),
data_contratacao date
);

create table producao_leite (
id_leite serial primary key,
id_animal int references animal(id_animal), -- criar trigger em que valida apenas animais que produzam leite, se nao lançar exceção
data_producao_leite date,
quantidade_litros int,
gordura percentual_fazenda
);

alter table producao_leite alter column quantidade_litros type quantidade_positiva;

create table producao_graos (
id_grao serial primary key,
id_plantacao int references plantacao(id_plantacao),
data_colheita date,
quantidade_kg int
);

alter table producao_graos alter column quantidade_kg type quantidade_positiva;

create table manutencao_equipamento (
id_manutencao serial primary key,
id_equipamento int references equipamento(id_equipamento), 
tipo_manutencao tipo_manutencao,
status_manutencao status_manutencao,
partes_afetadas text
);

alter table manutencao_equipamento add column data_manutencao date;

drop table manutencao_equipamento;

create table alimentacao_animal (
id_alimentacao serial primary key,
id_animal int references animal(id_animal),
tipo_racao tipo_racao,
horario_alimentacao timestamp,
quantidade_fornecida quantidade_positiva,
dieta_especial boolean
);

-- funcoes com e sem trigger

-- funcao para validar producao de leite 

create trigger validar_leite
before insert on producao_leite
for each row
execute procedure analisar_leite();

create or replace function analisar_leite()
returns trigger as $$
declare
animais tipo_animal;
sexo sexo_animal;
litros int;
begin
select tipo_animal, sexo_animal into animais, sexo
from animal 
where id_animal = new.id_animal;

if (animais = 'SUINO' or animais = 'AVES') then
raise exception 'não foi possivel registrar a producao de leite pois o tipo de animal nao o produz para consumo humano';
else 
   if sexo = 'MACHO' then
    raise exception 'não foi possivel registrar a producao de leite pois o animal relacionado é macho';
  end if;
end if;	

litros := new.quantidade_litros; 

if (litros <= 0) then
  raise exception 'não foi possivel registrar a producao de leite pois a quantidade em litros esta menor que 0';
end if;  

return new;
end;
$$ language plpgsql;

-- função que calcule a idade atual de um animal a partir de sua data de nascimento 
drop function calcular_idade_animal(int);

create or replace function calcular_idade_animal(animal_id int)
returns text as $$
declare
data_nascimento_animal date;
idade int;
idade_animal text;
begin
select data_nascimento into data_nascimento_animal
from animal
where id_animal = animal_id;

if not found then
  raise exception 'não foi possivel calcular a idade do animal, pois ele não foi encontrado';
end if;  
  
idade := extract(year from current_date) - extract(year from data_nascimento_animal);

idade_animal := cast(idade as text);

if (idade < 1) then
  return 'esse animal tem apenas alguns meses de idade';
else 
  return 'esse animal tem ' || idade_animal || ' anos de idade';
end if;
end;
$$ language plpgsql;

select calcular_idade_animal(2);

