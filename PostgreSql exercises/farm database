-- trigger para garantir que a area nao seja menor que 0
create trigger verificar_area
before insert or update on plantacao
for each row
execute procedure analisar_area();

create or replace function analisar_area()
returns trigger as $$
begin
if new.area_hectares <= 0 then
  raise exception 'não foi possivel inserir essa plantacao pois a area esta menor que 0';
end if;

return new;
end;
$$ language plpgsql;

-- um trigger que atualize o peso médio por tipo e sexo de animal após cada inserção na tabela de alimentação
create trigger atualizar_peso
after insert or update on alimentacao_animal
for each row
execute procedure analisar_peso();

create or replace function analisar_peso()
returns trigger as $$
declare
tipo tipo_animal;
sexo sexo_animal;
begin
select tipo_animal, sexo_animal into tipo, sexo
from animal
where id_animal = new.id_animal;

case 
  when (sexo = 'MACHO') then
    if (tipo = 'BOVINO') then
	  update animal set peso_animal = peso_animal + 1.25
	  where id_animal = new.id_animal;
	elsif (tipo = 'EQUINO') then
	  update animal set peso_animal = peso_animal +  7
	  where id_animal = new.id_animal;
	elsif (tipo = 'SUINO') then
	  update animal set peso_animal = peso_animal +  0.80
	  where id_animal = new.id_animal;
	elsif (tipo = 'OVINOS') then
	  update animal set peso_animal = peso_animal +  0.20
	  where id_animal = new.id_animal;
	elsif (tipo = 'CAPRINOS') then
	  update animal set peso_animal = peso_animal +  0.15
	  where id_animal = new.id_animal;
	else
	  update animal set peso_animal = peso_animal +  0.6
	  where id_animal = new.id_animal;
	end if;
 when (sexo = 'FÊMEA') then
    if (tipo = 'BOVINO') then
	  update animal set peso_animal = peso_animal +  1
	  where id_animal = new.id_animal;
	elsif (tipo = 'EQUINO') then
	  update animal set peso_animal = peso_animal +  4.5
	  where id_animal = new.id_animal;
	elsif (tipo = 'SUINO') then
	  update animal set peso_animal = peso_animal +  0.90
	  where id_animal = new.id_animal;
	elsif (tipo = 'OVINOS') then
	  update animal set peso_animal = peso_animal +  0.40
	  where id_animal = new.id_animal;
	elsif (tipo = 'CAPRINOS') then
	  update animal set peso_animal = peso_animal +  0.20
	  where id_animal = new.id_animal;
	else
	  update animal set peso_animal = peso_animal +  0.12
	  where id_animal = new.id_animal;	
	end if;
end case;

return new;
end;
$$ language plpgsql;


