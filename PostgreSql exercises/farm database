-- consultas

-- Liste os 5 animais que mais produziram leite no último mês, ordenados por produção decrescente 
select animal.nome_animal, animal.tipo_animal, sum(producao_leite.quantidade_litros) as litros_de_leite_produzido
from animal inner join producao_leite on animal.id_animal = producao_leite.id_animal
where producao_leite.data_producao_leite between current_date - interval '1 month' and current_date
group by animal.nome_animal, animal.tipo_animal
order by sum(producao_leite.quantidade_litros) desc
limit 5;

-- Calcule a produção média diária de leite por tipo de animal nos últimos 30 dias
select animal.tipo_animal, producao_leite.data_producao_leite, avg(producao_leite.quantidade_litros) over(partition by animal.tipo_animal order by extract(day from producao_leite.data_producao_leite) desc) as media_diaria
from animal inner join producao_leite on animal.id_animal = producao_leite.id_animal
where producao_leite.data_producao_leite between current_date - interval '30 days' and current_date
group by animal.tipo_animal, producao_leite.data_producao_leite, producao_leite.quantidade_litros

-- 	Encontre os equipamentos que precisam de manutenção (não tiveram manutenção nos últimos 6 meses) 
select equipamento.id_equipamento, equipamento.nome_equipamento, max(manutencao_equipamento.data_manutencao) as data_utlima_manutencao
from equipamento left join manutencao_equipamento on equipamento.id_equipamento = manutencao_equipamento.id_equipamento
group by equipamento.id_equipamento, equipamento.nome_equipamento
having max(manutencao_equipamento.data_manutencao) is null
or max(manutencao_equipamento.data_manutencao) < current_date - interval '6 months';

-- Mostre a evolução mensal da produção de grãos por tipo de plantação no último ano 
select plantacao.tipo_plantacao, extract(month from producao_graos.data_colheita), sum(producao_graos.quantidade_kg) over(partition by plantacao.tipo_plantacao order by extract(month from producao_graos.data_colheita) desc) as evolucao_mensal_colheita
from plantacao inner join producao_graos on plantacao.id_plantacao = producao_graos.id_plantacao
where producao_graos.data_colheita between current_date - interval '1 year' and current_date
group by plantacao.tipo_plantacao, producao_graos.quantidade_kg, producao_graos.data_colheita;

-- Calcule o custo total com salários por cargo, incluindo o percentual que cada cargo representa no total
select funcionario_fazenda.cargo_funcionario, sum(funcionario_fazenda.salario) as custo_total, round((count(*) * 100.0 / sum(count(*)) over()), 2) as percentual_de_funcionarios
from funcionario_fazenda
group by funcionario_fazenda.cargo_funcionario;

-- Mostre a produtividade (kg/hectare) de cada plantação, comparada com a média da fazenda
select plantacao.id_plantacao, plantacao.tipo_plantacao, sum(producao_graos.quantidade_kg / plantacao.area_hectares) over(partition by plantacao.id_plantacao order by producao_graos.data_colheita desc) as quilogramas_produzidos_por_hectare,
avg(producao_graos.quantidade_kg / plantacao.area_hectares) as media_da_fazenda
from plantacao inner join producao_graos on plantacao.id_plantacao = producao_graos.id_plantacao
group by plantacao.id_plantacao, plantacao.tipo_plantacao, producao_graos.quantidade_kg, plantacao.area_hectares, producao_graos.data_colheita
