-- Liste todos os pedidos com os nomes dos clientes e a data do pedido.
select clientes.nome_cliente, pedidos.data_pedido, produtos.nome_produto, itens_pedido.quantidade from clientes
inner join pedidos on clientes.id_cliente = pedidos.id_cliente
inner join itens_pedido on pedidos.id_pedido = itens_pedido.id_pedido
inner join produtos on itens_pedido.id_produto = produtos.id_produto
group by clientes.nome_cliente, pedidos.data_pedido, produtos.nome_produto, itens_pedido.quantidade

-- Calcule o valor total de cada pedido.
select pedidos.id_pedido, produtos.nome_produto, itens_pedido.quantidade, sum(produtos.preco_produto * itens_pedido.quantidade) as valor_total_do_pedido from
pedidos inner join itens_pedido on pedidos.id_pedido = itens_pedido.id_pedido
inner join produtos on itens_pedido.id_produto = produtos.id_produto
group by pedidos.id_pedido, produtos.nome_produto, itens_pedido.quantidade

--Encontre o cliente que mais gastou.
select clientes.nome_cliente, sum(produtos.preco_produto * itens_pedido.quantidade) as valor_gasto_total from clientes
inner join pedidos on clientes.id_cliente = pedidos.id_cliente
inner join itens_pedido on pedidos.id_pedido = itens_pedido.id_pedido
inner join produtos on itens_pedido.id_produto = produtos.id_produto
group by clientes.nome_cliente
order by valor_gasto_total desc
limit 1;

-- Liste os produtos mais vendidos (em quantidade).
select produtos.nome_produto, itens_pedido.quantidade from itens_pedido
inner join produtos on itens_pedido.id_produto = produtos.id_produto
group by produtos.nome_produto, itens_pedido.quantidade
order by itens_pedido.quantidade desc;

-- Calcule o faturamento total por categoria de produto
select produtos.categoria_produto, sum(produtos.preco_produto * itens_pedido.quantidade) as fauramento_total_por_categoria
from produtos inner join itens_pedido on produtos.id_produto = itens_pedido.id_produto
group by produtos.categoria_produto;

-- Calcule o número médio de itens por pedido
select pedidos.id_pedido, avg(itens_pedido.quantidade) as media_itens_por_pedido
from pedidos inner join itens_pedido on pedidos.id_pedido = itens_pedido.id_pedido
group by pedidos.id_pedido

-- Listar os clientes que fizeram pedidos em uma cidade específica:
select clientes.nome_cliente, clientes.cidade_cliente from clientes
where clientes.cidade_cliente like 'vito%'
group by clientes.nome_cliente, clientes.cidade_cliente

-- Calcular o valor médio gasto por cliente:
select clientes.nome_cliente, avg(produtos.preco_produto * itens_pedido.quantidade) as valor_total_gasto
from clientes inner join pedidos on clientes.id_cliente = pedidos.id_cliente
inner join itens_pedido on pedidos.id_pedido = itens_pedido.id_pedido
inner join produtos on itens_pedido.id_produto = produtos.id_produto
group by clientes.nome_cliente

-- Encontrar o produto mais caro vendido:
select produtos.nome_produto, produtos.categoria_produto, max(produtos.preco_produto) as produto_mais_caro_vendido
from produtos inner join itens_pedido on produtos.id_produto = itens_pedido.id_produto
inner join pedidos on itens_pedido.id_pedido = pedidos.id_pedido
group by produtos.nome_produto, produtos.categoria_produto
order by produto_mais_caro_vendido desc
limit 1;

-- Listar os pedidos feitos em um intervalo de datas:
select pedidos.id_pedido, pedidos.data_pedido, clientes.nome_cliente from pedidos
inner join clientes on pedidos.id_cliente = clientes.id_cliente
where pedidos.data_pedido between '2025-02-14' and '2025-02-17'
group by pedidos.id_pedido, pedidos.data_pedido, clientes.nome_cliente

-- Calcular o número total de pedidos por cliente:
select clientes.nome_cliente, count(pedidos.id_pedido) as pedidos_feitos
from clientes inner join pedidos on clientes.id_cliente = pedidos.id_cliente
group by clientes.nome_cliente;

-- Encontrar o cliente que fez o maior número de pedidos:
select clientes.nome_cliente, count(pedidos.id_pedido) as pedidos_feitos
from clientes inner join pedidos on clientes.id_cliente = pedidos.id_cliente
group by clientes.nome_cliente
order by pedidos_feitos desc
limit 1;

-- Calcular o valor total gasto por cliente em uma categoria específica:
select clientes.nome_cliente, produtos.categoria_produto, sum(produtos.preco_produto * itens_pedido.quantidade)
from clientes inner join pedidos on clientes.id_cliente = pedidos.id_cliente
inner join itens_pedido on pedidos.id_pedido = itens_pedido.id_pedido
inner join produtos on itens_pedido.id_produto = produtos.id_produto
where produtos.categoria_produto = 'smartphone'
group by clientes.nome_cliente, produtos.categoria_produto;

-- Listar os pedidos que contêm mais de um produto:
select pedidos.id_pedido, produtos.nome_produto, itens_pedido.quantidade
from pedidos inner join itens_pedido on pedidos.id_pedido = itens_pedido.id_pedido
inner join produtos on itens_pedido.id_produto = produtos.id_produto
where itens_pedido.quantidade > 1
group by pedidos.id_pedido, produtos.nome_produto, itens_pedido.quantidade;

-- Listar os clientes que fizeram pedidos acima de um valor específico:
select clientes.nome_cliente, pedidos.id_pedido, sum(produtos.preco_produto * itens_pedido.quantidade) as valor_gasto
from clientes inner join pedidos on clientes.id_cliente = pedidos.id_cliente
inner join itens_pedido on pedidos.id_pedido = itens_pedido.id_pedido
inner join produtos on itens_pedido.id_produto = produtos.id_produto
group by clientes.nome_cliente, pedidos.id_pedido
having sum(produtos.preco_produto * itens_pedido.quantidade) > 5000

-- Calcular o número de produtos vendidos por categoria:
select produtos.categoria_produto, sum(itens_pedido.quantidade) as produtos_vendidos
from produtos right join itens_pedido on produtos.id_produto = itens_pedido.id_produto
group by produtos.categoria_produto

-- Calcular o faturamento total por mês:
select sum(faturamento_total) as faturamento_total_no_mes
from
   (select pedidos.data_pedido, sum(produtos.preco_produto * itens_pedido.quantidade) as faturamento_total
     from pedidos inner join itens_pedido on pedidos.id_pedido = itens_pedido.id_pedido
      inner join produtos on itens_pedido.id_produto = produtos.id_produto
       where pedidos.data_pedido between '2025-02-01' and '2025-02-28'
        group by pedidos.data_pedido)
     as subquery;

-- liste os clientes que nunca fizeram um pedido
select clientes.nome_cliente
from clientes left join pedidos on clientes.id_cliente = pedidos.id_cliente
where pedidos.id_cliente is null;

-- Encontrar o produto mais vendido em termos de valor total:
select produtos.nome_produto, produtos.categoria_produto, sum(produtos.preco_produto * itens_pedido.quantidade) as valor_faturamento_total
from produtos inner join itens_pedido on produtos.id_produto = itens_pedido.id_produto
group by produtos.nome_produto, produtos.categoria_produto
order by valor_faturamento_total desc
limit 1;
	 
	  
