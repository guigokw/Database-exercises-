-- Função básica para calcular idade do paciente
create or replace function calcular_idade(nascimento date)
returns smallint as $$
declare
idade smallint;
begin
idade = extract(year from current_date) - extract(year from nascimento);
return idade;
end;
$$ language plpgsql;

select calcular_idade('2006-07-17');
select calcular_idade('1951-01-21');

drop function  gerar_relatorio_diario

-- Função avançada para gerar relatório diário
create or replace function gerar_relatorio_diario(dia date)
returns table (especialidade especialidade, tempo_consulta time, consultas_realizadas bigint) as $$
begin
return query
select m.especialidade_medico, sum((c.horario_consulta).hora_final - (c.horario_consulta).hora_inicial)::time as tempo_consulta, count(c.id_consulta) as consultas_realizadaa from medicos m
inner join consulta c on m.crm_medico = c.crm_medico
where (c.horario_consulta).data_consulta = dia 
group by m.especialidade_medico;
end;
$$ language plpgsql;

select * from gerar_relatorio_diario('2025-01-25');
select * from gerar_relatorio_diario('2025-02-16');
select * from gerar_relatorio_diario('2025-04-16');

-- Consulta que mostra médicos mais demandados:
select medicos.especialidade_medico, count(consulta.id_consulta) as consultas_feitas, sum((consulta.horario_consulta).hora_final - (consulta.horario_consulta).hora_inicial)::time as tempo_total_de_consulta
from consulta inner join medicos on consulta.crm_medico = medicos.crm_medico
group by medicos.especialidade_medico
order by consultas_feitas desc

-- Análise de cancelamentos:
select pacientes.plano_saude_paciente, count(consulta.id_consulta) as consultas_canceladas
from pacientes inner join consulta on pacientes.cpf_paciente = consulta.cpf_paciente
where (consulta.horario_consulta).data_consulta between '2025-01-16' and current_date and consulta.status_consulta = 'cancelada'
group by pacientes.plano_saude_paciente
