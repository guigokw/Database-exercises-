create database posto_de_saude;

create type tipos_consulta as enum('consulta basica', 'exame', 'retorno', 'emergencia');

create type especialidade as enum('cardiologia', 'psiquiatria', 'ortodontia', 'pediatria', 'medicina interna', 'neurologia');

create type plano as enum('basico', 'particular', 'premium');

create type status as enum('agendada', 'realizada', 'cancelada');


create domain crm as varchar(6) 
check (length(value) = 6 and value ~ '^[0-9]+$' );

create domain cpf as varchar(11)
check (length(value) = 11 and value ~ '^[0-9]+$');

create type horario_agendado as (
data_consulta date,
hora_inicial time,
hora_final time,
sala text
);

create table medicos (
crm_medico crm not null primary key,
nome_medico varchar(200) not null,
especialidade_medico especialidade
);

create table pacientes (
cpf_paciente cpf not null primary key,
nome_paciente varchar(200) not null,
data_nascimento_paciente date not null,
plano_saude_paciente plano not null
);

create table consulta (
id_consulta serial primary key,
horario_consulta horario_agendado,
status_consulta status,
tipo_consulta tipos_consulta,
crm_medico varchar(6) references medicos(crm_medico),
cpf_paciente varchar(11) references pacientes(cpf_paciente)
);



