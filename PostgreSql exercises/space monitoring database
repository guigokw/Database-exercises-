-- funcoes com trigger

-- atualizar status do satelite
drop trigger atualizar_status on satelite

create trigger atualizar_status
before insert or update on satelite
for each row
execute procedure verificar_bateria();

create or replace function verificar_bateria()
returns trigger as $$
begin
if (new.bateria < 5) then
  new.status_satelite = 'INATIVO';
end if;

return new;
end;
$$ language plpgsql;

-- validar a data da missao espacial
create trigger validar_data
before insert or update on missao
for each row 
execute procedure verificar_data();

create or replace function verificar_data()
returns trigger as $$
begin
if (new.data_fim <= new.data_inicio) then
  raise exception 'não foi possivel validar a missão pois a data de fim da missao foi registrada como antes da data de inicio';
end if;
return new;
end;
$$ language plpgsql;

-- validar lançamento do satelite
create trigger validar_lancamento
before insert or update on satelite
for each row
execute procedure verificar_lancamento();

create or replace function verificar_lancamento()
returns trigger as $$
begin
if (new.data_lancamento > current_date and new.status_satelite = 'ATIVO') then
  raise exception 'não foi possivel realizar o lancamento do satelite, pois a data de lancamernto esta marcada para uma data futura e o status foi classificado como ativo, neccessario alteração';
end if;
return new;
end;
$$ language plpgsql;

-- bloquear dados de observacao de planeta desativado
create trigger bloquear_insercao
before insert or update on dados_observacao
for each row
execute procedure bloquear_dados_planeta_desativado();

create or replace function bloquear_dados_planeta_desativado()
returns trigger as $$
declare
missao_status status_missao;
begin
select missao.status_missao into missao_status
from missao inner join planeta on missao.id_planeta = planeta.id_planeta
where planeta.id_planeta = new.id_planeta;

if (missao_status = 'CONCLUIDA' or missao_status = 'FALHA') then
  raise exception 'a insercao de dados foi bloquaeada foi essa missao ja foi registrada como concluida ou como uma falha';
end if;

return new;
end;
$$ language plpgsql;


