-- Satélites ativos com bateria crítica (< 10%) e suas missões.
select satelite.nome_satelite, satelite.bateria, missao.nome_missao from satelite
left join orbita on satelite.id_satelite = orbita.id_satelite
left join planeta on orbita.id_planeta = planeta.id_planeta
left join missao on planeta.id_planeta = missao.id_missao
where satelite.bateria < 10 and satelite.status_satelite = 'ATIVO';

