-- calcular a distancia entre dois satelites em km
create or replace function calcular_distancia_satelite(satelite_id_1 int, satelite_id_2 int)
returns numeric(10,2) as $$
declare 
existe boolean;
existe2 boolean;
distancia numeric(10,2);
latitude_1 numeric(10,2);
longitude_1 numeric(10,2);
altitude_km_1 altitude_km;
latitude_2 numeric(10,2);
longitude_2 numeric(10,2);
altitude_km_2 altitude_km;
x_1 numeric(10,2);
y_1 numeric(10,2);
z_1 numeric(10,2);
x_2 numeric(10,2);
y_2 numeric(10,2);
z_2 numeric(10,2);
begin
select exists (
    select 1 from satelite
	where id_satelite = satelite_id_1
) into existe;

select exists (
    select 1 from satelite
	where id_satelite = satelite_id_2
) into existe2;

if not existe then
  raise exception 'não foi possivel calcular a distancia pois o satelite 1 fornecido não foi encontrado';
end if;

if not existe2 then
   raise exception 'não foi possivel calcular  distancia pois o satelite 2 fornecido não foi encontrado';
end if;   

select (orbita.coordenadas).latitude, (orbita.coordenadas).longitude, (orbita.coordenadas).altitude_km into
latitude_1, longitude_1, altitude_km_1
from orbita where id_satelite = satelite_id_1;

select (orbita.coordenadas).latitude, (orbita.coordenadas).longitude, (orbita.coordenadas).altitude_km
into latitude_2, longitude_2, altitude_km_2
from orbita where id_satelite = satelite_id_2;

x_1 = (6371 + altitude_km_1) * cos(radians(latitude_1)) * cos(radians(longitude_1));

y_1 = (6371 + altitude_km_1) * cos(radians(latitude_1)) * sin(radians(longitude_1));

z_1 = (6371 + altitude_km_1) * sin(radians(latitude_1));

x_2 = (6371 + altitude_km_2) * cos(radians(latitude_2)) * cos(radians(longitude_2));

y_2 = (6371 + altitude_km_2) * cos(radians(latitude_2)) * sin(radians(longitude_2));

z_2 = (6371 + altitude_km_2) * sin(radians(latitude_2));

distancia = sqrt(pow(x_2 - x_1, 2) + pow(y_2 - y_1, 2) + pow(z_2 - z_1, 2));

return distancia;
end;
$$ language plpgsql;

select calcular_distancia_satelite(1, 2);

drop function calcular_bateria_restante(int);

-- calcular tempo restante de bateria de um satelite especifico
create or replace function calcular_bateria_restante(satelite_id int)
returns numeric(10,2) as $$
declare
bateria_usada numeric(10,2);
bateria_restante numeric(10,2);
consumo_diario numeric(10,2);
dias_totais numeric(10,2);
dias numeric(10,2);
existe boolean;
dias_restantes numeric(10,2);
begin
select exists (
   select 1 from satelite
   where id_satelite = satelite_id
) into existe;

if not existe then
  raise exception 'não foi possivel calcular o tempo restante de bateria, pois o satelite não foi encontrado';
end if;

select bateria, extract(epoch from age(current_date::date, data_lancamento::date)) / 86400 into bateria_restante, dias
from satelite
where id_satelite = satelite_id;

bateria_usada := 100 - bateria_restante;

consumo_diario := bateria_usada / dias;

dias_totais = 100 / consumo_diario;

dias_restantes = dias_totais - dias;

return dias_restantes;
end;
$$ language plpgsql;

select calcular_bateria_restante(1);

-- verificar se os satelites tem risco de colisão - resolvi inserir os dados de alerta de colisão aqui pois nao consgeui achar uma maneira de fazer isso com trigger
create or replace function verificar_risco_colisao(satelite_1 int, satelite_2 int)
returns text as $$
declare
distancia int;
begin
distancia := calcular_distancia_satelite(satelite_1, satelite_2);

if (distancia < 50) then
  return 'os satelite estao correndo risco de colisão';
  insert into alerta_colisao values
  (default, satelite_1, satelite_2, current_timestamp, distancia, 'ALTA');
else 
  return 'não há risco de colisão no momento';
end if;
end;
$$ language plpgsql;

