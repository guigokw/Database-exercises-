-- Planetas com mais dados coletados
select planeta.nome_planeta, count(dados_observacao.id_dado) as dados_coletados
from planeta inner join dados_observacao on planeta.id_planeta = dados_observacao.id_planeta
group by planeta.nome_planeta
order by count(dados_observacao.id_dado) desc;

-- Média de velocidade orbital por tipo de satélite
select satelite.tipo_satelite, avg(orbita.velocidade_km) as media_velocidade
from satelite inner join orbita on satelite.id_satelite = orbita.id_satelite
group by satelite.tipo_satelite;

-- Ranking de satélites por tempo em órbita 
select satelite.nome_satelite, rank() over(order by satelite.data_lancamento) as ranking_tempo_orbita
from satelite 
group by satelite.nome_satelite, satelite.id_satelite, satelite.data_lancamento;
