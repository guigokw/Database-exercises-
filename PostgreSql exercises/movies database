create database gerenciamento_filmes;

create type classificacao as enum('L', '10', '12', '14', '16', '18');

create domain codigo_filme as varchar(5)
check(length(value) = 5);

create domain duracao_filme as smallint
check (value between 5 and 240);

create domain data_lancamento as date
check (value < current_date);

create type endereco as (
rua text,
numero_rua int,
cidade varchar(100),
estado varchar(100) 
);

create table cinema (
id_cinema serial primary key,
nome_cinema varchar(200) not null,
endereco endereco not null
);

create table filme (
codigo codigo_filme primary key,
titulo_filme varchar(200) not null, 
duracao_minutos duracao_filme,
classificacao_etaria classificacao,
data_lancamento data_lancamento
);


create table sessao (
id_sessao serial primary key,
filme_codigo codigo_filme references filme(codigo),
id_cinema int references cinema(id_cinema),
data_hora timestamp,
ingressos_vendidos int default 0
);

create or replace function listar_filmes_por_classificacao(classificacao_filme classificacao)
returns table (codigo codigo_filme, titulo varchar(200), duracao_em_minutos duracao_filme) as $$
begin
return query
select f.codigo, f.titulo_filme, f.duracao_minutos from filme f
where f.classificacao_etaria = classificacao_filme;
end;
$$ language plpgsql;

create or replace function sessoes_agendadas(codigo_input codigo_filme)
returns int as $$
declare
ids_sessoes int;
begin
select count(s.id_sessao) into ids_sessoes from sessao s
where filme_codigo = codigo_input;

return ids_sessoes;
end;
$$ language plpgsql;


CREATE OR REPLACE FUNCTION calcular_total_arrecadado(
    codigo_filme_input codigo_filme,
    preco_ingresso NUMERIC(6,2))
RETURNS numeric(10,2) AS $$
declare
total_ingressos int = 0;
BEGIN
    select sum(ingressos_vendidos) into total_ingressos
	from sessao
	where filme_codigo = codigo_filme_input;

	return total_ingressos * preco_ingresso;
END;
$$ LANGUAGE plpgsql;

create or replace function filme_mais_popular(id_cinema_input int)
returns table (titulo varchar(200), total_ingressos_vendidos bigint) as $$
begin
return query
select f.titulo_filme, sum(s.ingressos_vendidos) as total_ingressos_vendidos from
filme f inner join sessao s on f.codigo = s.filme_codigo
inner join cinema c on s.id_cinema = c.id_cinema
where c.id_cinema = id_cinema_input
group by f.titulo_filme
order by total_ingressos_vendidos desc
limit 1;
end;
$$ language plpgsql;

create or replace function total_ingressos_vendidos_em_periodo_tempo(comeco_data date, fim_data date)
returns table (nome_cinema varchar(200), total_ingressos_vendidos bigint) as $$
begin
return query
select c.nome_cinema, sum(s.ingressos_vendidos) as total_ingressos_vendidos from
cinema c inner join sessao s on c.id_cinema = s.id_cinema
inner join filme f on s.filme_codigo = f.codigo
where f.data_lancamento between comeco_data and fim_data
group by c.nome_cinema
order by total_ingressos_vendidos desc
limit 1;
end;
$$ language plpgsql;


