-- windows functions

-- 1 - Calcular a produção acumulada de mel por colmeia ao longo do tempo
select colmeias.id_colmeia, producao_mel.data_coleta, sum((producao_mel.qualidade_mel).quantidade_colida_em_kg) over(partition by colmeias.id_colmeia order by producao_mel.data_coleta) as quantidade_colida_ao_Longo_do_tempo
from colmeias inner join producao_mel on colmeias.id_colmeia = producao_mel.id_colmeia
group by colmeias.id_colmeia, producao_mel.data_coleta, (producao_mel.qualidade_mel).quantidade_colida_em_kg;

-- 2 - Rankear colmeias por produtividade relativa (comparando com a média do apiário)
with base as (
  select colmeias.id_colmeia,
  dense_rank() over (order by sum((producao_mel.qualidade_mel).quantidade_colida_em_kg) desc) as ranking
  from colmeias inner join producao_mel on colmeias.id_colmeia = producao_mel.id_colmeia
  group by colmeias.id_colmeia
),
valores_totais as (
     select 
	 colmeias.id_colmeia,
	 sum((producao_mel.qualidade_mel).quantidade_colida_em_kg) as total_producao,
     avg((producao_mel.qualidade_mel).quantidade_colida_em_kg) as media_apiario
	 from producao_mel inner join colmeias on producao_mel.id_colmeia = colmeias.id_colmeia
	 group by colmeias.id_colmeia
)
select base.id_colmeia, valores_totais.total_producao, valores_totais.media_apiario, base.ranking
from base inner join valores_totais on base.id_colmeia = valores_totais.id_colmeia
