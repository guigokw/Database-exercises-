);

-- Relatório de Sensor
create or replace function gerar_relatorio_sensor(id_sensor_input int, data_inicio date, data_fim date)
returns relatorio_sensor as $$
declare
media_velocidade_variavel velocidade_media;
pico_trafego_variavel int;
status_operacao_variavel status_sensor_trafego;
begin
select avg(r.velocidade_media), max(r.volume_veiculos), s.status_sensor
into media_velocidade_variavel, pico_trafego_variavel, status_operacao_variavel
from sensor_trafego s inner join registro_trafego r 
on s.id_sensor = r.id_sensor
where s.id_sensor = id_sensor_input and r.data_registro between data_inicio and data_fim
group by s.status_sensor;

if not found then
raise exception 'nao foi possivel gerar relatorio pois o sensor nao foi encontrado |OU| nao tem registro entre as datas fornecidas';
end if;

return (media_velocidade_variavel, pico_trafego_variavel, status_operacao_variavel)::relatorio_sensor;

EXCEPTION
    WHEN OTHERS THEN
        RAISE EXCEPTION 'Erro no relatorio: %', SQLERRM;
        RETURN false;

end;
$$ language plpgsql;

