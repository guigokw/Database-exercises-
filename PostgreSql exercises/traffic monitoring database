);

-- alerta de trafego
create or replace function gerar_alerta_trafego(id_sensor_input int, volume_input int, infracoes_input int, velocidade_input int)
returns alerta_trafego as $$
declare
status_sensor_variavel status_sensor_trafego;
localizacao_variavel point;
begin
select s.status_sensor, s.localizacao into status_sensor_variavel, localizacao_variavel from sensor_trafego s
where s.id_sensor = id_sensor_input;

if not found then
raise exception 'nao foi possivel gerar alerta pois o sensor nao foi encontrado';
end if;

if status_sensor_variavel <> 'ATIVO' then
raise exception 'nao foi possivel gerar alerta pois o sensor nao esta ativo';
end if;

if volume_input <= 0 or velocidade_input <= 0 then
raise exception 'nao é necessario gerar alerta pois não há veiculos na pista';
end if;

if infracoes_input <= 0 then
raise exception 'não é necessario gerar alerta pois não há infracoes registrada';
end if;

case 
  when volume_input <= 30 and infracoes_input >= 8 and velocidade_input <= 20 then
    return ('ACIDENTE', 'cuidado a frente pois a um acidente registrado', 'ALTO', current_timestamp, localizacao_variavel)::alerta_trafego;
  when volume_input <= 50 and infracoes_input >= 4 and velocidade_input <= 50 then
    return ('CURVA PERIGOSA', 'cuidado a frente pois há uma curva perigosa na estrada', 'MEDIO', current_timestamp, localizacao_variavel)::alerta_trafego;
  else
    return ('DESCIDA INGREME', 'cuidado a frente pois há uma descida muito ingreme, risco de acidente', 'BAIXO', current_timestamp, localizacao_variavel)::alerta_trafego;
end case;

EXCEPTION
    WHEN OTHERS THEN
        RAISE EXCEPTION 'Erro na geração de alerta: %', SQLERRM;
        RETURN false;
end;
