-- Análise Comparativa
create or replace function comparar_vias(id_via_1 int, id_via_2 int)
returns comparacao_vias as $$
declare
nome_via_variavel_1 varchar(200);
diferença_volume_variavel int;
comparacao_velocidades_variavel int;
volume_veiculos_variavel_1 int;
velocidade_media_variavel_1 int;
maximo_infracoes_variavel_1 int;
volume_veiculos_variavel_2 int;
velocidade_media_variavel_2 int;
maximo_infracoes_variavel_2 int;
nome_via_variavel_2 varchar(200);
begin
select (v.dados_via).nome_via, max(i.id_infracao), sum(r.volume_veiculos), avg(r.velocidade_media)
into nome_via_variavel_1, maximo_infracoes_variavel_1, volume_veiculos_variavel_1, velocidade_media_variavel_1
from via_urbana v inner join sensor_trafego s on v.id_via = s.id_via
inner join registro_trafego r on s.id_sensor = r.id_sensor
inner join infracao i on r.id_registro = i.id_registro
where v.id_via = id_via_1
group by (v.dados_via).nome_via;

select (v.dados_via).nome_via, max(i.id_infracao), sum(r.volume_veiculos), avg(r.velocidade_media)
into nome_via_variavel_2, maximo_infracoes_variavel_2, volume_veiculos_variavel_2, velocidade_media_variavel_2
from via_urbana v inner join sensor_trafego s on v.id_via = s.id_via
inner join registro_trafego r on s.id_sensor = r.id_sensor
inner join infracao i on r.id_registro = i.id_registro
where v.id_via = id_via_2
group by (v.dados_via).nome_via;

if not found then
raise exception 'nao foi possivel comparar as vias pois alguma das vias não foi encontrada';
end if;

if volume_veiculos_variavel_1 > volume_veiculos_variavel_2 then
diferença_volume_variavel = volume_veiculos_variavel_1 - volume_veiculos_variavel_2;
else
diferença_volume_variavel = volume_veiculos_variavel_2 - volume_veiculos_variavel_1;
end if;

if velocidade_media_variavel_1 > velocidade_media_variavel_2 then
comparacao_velocidades_variavel = velocidade_media_variavel_1 - velocidade_media_variavel_2;
else
comparacao_velocidades_variavel = velocidade_media_variavel_2 - velocidade_media_variavel_1;
end if;

case 
   when maximo_infracoes_variavel_1 > maximo_infracoes_variavel_2 then
     return (nome_via_variavel_1, diferença_volume_variavel, comparacao_velocidades_variavel)::comparacao_vias;
   else	
     return (nome_via_variavel_2, diferença_volume_variavel, comparacao_velocidades_variavel)::comparacao_vias;
end case;

EXCEPTION
    WHEN OTHERS THEN
        RAISE EXCEPTION 'Erro na comparação: %', SQLERRM;
        RETURN false;
end; 
$$ language plpgsql;

