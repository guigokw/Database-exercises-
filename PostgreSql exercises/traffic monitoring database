select infracao.tipo_infracao, infracao.gravidade_infracao into tipo_infracao_variavel, gravidade_infracao_variavel
from registro_trafego inner join infracao on registro_trafego.id_registro = infracao.id_registro
where registro_trafego.id_registro = id_registro_input;

if not found then
