-- Função de Verificação de Limite de Velocidade
create or replace function verificar_velocidade(id_via_input int, limite_velocidade_input limite_velocidade)
returns text as $$
declare
media_velocidade_variavel int;
begin
select registro_trafego.velocidade_media into media_velocidade_variavel
from via_urbana inner join sensor_trafego on via_urbana.id_via = sensor_trafego.id_via
inner join registro_trafego on sensor_trafego.id_sensor = registro_trafego.id_sensor
where via_urbana.id_via = id_via_input;

if not found then 
raise exception 'nao foi possivel verificar a velocidade pois o id da via nao foi encontrado';
end if;

if media_velocidade_variavel <= 0 or media_velocidade_variavel is null then
raise exception 'nao foi possivel verificar a velocidade pois nao há registro de velocidade media';
end if;

case
   when media_velocidade_variavel > limite_velocidade_input then
     return 'FORA DOS LIMITES DE VELOCIDADE';
   else
     return 'DENTRO DOS LIMITES DE VELOCIDADE';
end case;

EXCEPTION
    WHEN OTHERS THEN
        RAISE EXCEPTION 'Erro no varificação: %', SQLERRM;
        RETURN false;
end;
$$ language plpgsql;	 

