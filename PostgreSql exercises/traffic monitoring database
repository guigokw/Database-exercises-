	when tipo_infracao_variavel = 'EXCESSO DE VELOCIDADE' and gravidade_infracao_variavel = 'GRAVE' then
	    valor_multa = 880.41;
	when tipo_infracao_variavel = 'AVANCO DE SINAL' then
