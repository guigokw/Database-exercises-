create domain limite_velocidade as smallint
check (value between 20 and 120);

create domain velocidade_media as smallint
check (value between 0 and 200);

create domain horario_valido as time
check (value between '00:00:00' and '23:59:59');

create type dados_via as (
nome_via varchar(200),
tipo_via tipo_via,
limite_velocidade limite_velocidade,
quantidade_sensores int
);

create table via_urbana (
id_via serial primary key,
dados_via dados_via
);

create table sensor_trafego (
id_sensor serial primary key,
id_via int references via_urbana(id_via),
localizacao point,
status_sensor status_sensor_trafego
);

create table registro_trafego (
id_registro serial primary key,
id_sensor int references sensor_trafego(id_sensor),
data_hora timestamp,
velocidade_media velocidade_media,
intensidade intensidade_registro
);

