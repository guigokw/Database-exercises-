create database sistemaJuridico
default character set utf8mb4
default collate utf8mb4_general_ci;

use sistemaJuridico;

create table casos_juridicos (
id_caso int not null auto_Increment,
numero_processo int not null,
descricao text not null,
data_abertura date not null,
status_processo enum("pendente", "em andamento", "concluido") not null,
primary key (id_caso),
unique key (numero_processo)
) default charset utf8mb4;


create table partes_envolvidas (
id_parte int not null auto_increment,
id_caso int not null,
nome varchar(100) not null,
tipo enum("pessoa fisica", "pessoa juridica") not null,
documento varchar(100) not null,
primary key (id_parte),
foreign key (id_caso) references casos_juridicos (id_caso)
) default charset utf8mb4;

create table advogados (
id_advogado int not null auto_increment,
nome_advogado varchar(100) not null,
data_nascimento date not null,
especialização enum("direito civil", "direito penal", "direito administrativo", "direito da familia", "direito tributario", "direito do trabalho", "direito previdenciario", "direito publico", "direito constitucional") not null,
primary key (id_advogado)
) default charset utf8mb4;

create table juizes (
id_juiz int not null auto_increment,
nome_juiz varchar(100) not null,
tribunal enum("tribunal de justiça", "tribunal regional federal", "tribunal regional do trabalho") not null,
anos_experiencia tinyint not null,
primary key (id_juiz)
) default charset utf8mb4;

create table audiencias (
id_audiencia int not null auto_increment,
id_caso int not null,
id_juiz int not null,
id_advogado int not null,
data_audiencia date not null,
local_audiencia varchar(100) not null,
primary key (id_audiencia),
foreign key (id_caso) references casos_juridicos (id_caso),
foreign key (id_Juiz) references juizes (id_juiz),
foreign key (id_advogado) references advogados (id_advogado)
) default charset utf8mb4;

create table sentencas (
id_sentenca int not null auto_increment,
id_caso int not null,
veredicto text not null,
descricao_adicional text not null,
data_sentenca date not null,
primary key (id_sentenca),
foreign key (id_caso) references casos_juridicos (id_caso)
) default charset utf8mb4;

