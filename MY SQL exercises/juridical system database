-- Liste os casos judiciais com mais de uma parte envolvida.

select casos_juridicos.descricao, count(partes_envolvidas.id_caso) as partes_envolvidas_no_caso from casos_juridicos
inner join partes_envolvidas on casos_juridicos.id_caso = partes_envolvidas.id_caso
group by casos_juridicos.descricao
having partes_envolvidas_no_caso > 1;

-- Encontre todos os advogados que atuaram em mais de um caso.

select advogados.nome_advogado, count(audiencias.id_advogado) as casos_atuados from advogados
inner join audiencias on advogados.id_advogado = audiencias.id_advogado
group by advogados.nome_advogado
having casos_atuados > 1;

-- Encontre os casos pendentes que têm audiências programadas nos próximos 7 dias.

select casos_juridicos.descricao, casos_juridicos.status_processo, audiencias.data_audiencia from casos_Juridicos
inner join audiencias on casos_juridicos.id_caso = audiencias.id_caso
where audiencias.data_audiencia between "2024-12-08" and "2024-12-15"
group by casos_Juridicos.descricao, casos_Juridicos.status_Processo, audiencias.data_audiencia
having casos_Juridicos.status_processo like "penden%";

-- Liste os casos concluídos com as respectivas sentenças.

select casos_juridicos.descricao, casos_juridicos.status_processo, sentencas.veredicto, sentencas.descricao_adicional from casos_juridicos
inner join sentencas on casos_Juridicos.id_caso = sentencas.id_caso
group by casos_juridicos.descricao, casos_juridicos.status_processo, sentencas.veredicto, sentencas.descricao_adicional;


-- Liste os juízes que conduziram audiências para casos de status "pendente".

select juizes.nome_juiz, casos_Juridicos.descricao, casos_Juridicos.status_processo from juizes
inner join audiencias on juizes.id_juiz = audiencias.id_juiz
inner join casos_Juridicos on audiencias.id_caso = casos_juridicos.id_caso
group by juizes.nome_juiz, casos_Juridicos.descricao, casos_Juridicos.status_processo
having casos_Juridicos.status_processo like "pen%";

-- Identifique os casos que possuem mais de duas audiências agendadas, incluindo a quantidade de audiências.

select casos_Juridicos.descricao, count(audiencias.id_caso) as audiencias_agendadas from casos_Juridicos
inner join audiencias on casos_Juridicos.id_caso = audiencias.id_caso
group by casos_Juridicos.descricao
having audiencias_agendadas >= 2;

-- Liste os casos em que a parte envolvida é uma pessoa jurídica e o advogado responsável tem especialização em "direito do trabalho".

select casos_Juridicos.descricao, partes_envolvidas.tipo, advogados.nome_advogado, advogados.especialização from partes_envolvidas 
inner join casos_Juridicos on partes_envolvidas.id_caso = casos_Juridicos.id_caso
inner join audiencias on casos_Juridicos.id_caso = audiencias.id_caso
inner join advogados on audiencias.id_advogado = advogados.id_advogado
where partes_envolvidas.tipo like "%juridica"
group by casos_Juridicos.descricao, partes_envolvidas.tipo, advogados.nome_advogado,  advogados.especialização
having advogados.especialização like "%trabalho"; 

-- Encontre os juízes que conduziram audiências para casos que já possuem uma sentença registrada.

select juizes.nome_juiz, casos_Juridicos.descricao, sentencas.veredicto from casos_Juridicos
inner join sentencas on casos_Juridicos.id_caso = sentencas.id_caso
inner join audiencias on sentencas.id_caso = audiencias.id_caso
inner join juizes on audiencias.id_juiz = juizes.id_juiz
group by juizes.nome_juiz, casos_Juridicos.descricao, sentencas.veredicto;

-- Liste os juízes que têm mais de 10 anos de experiência e conduziram audiências para casos de "direito previdenciário".

select juizes.nome_juiz, juizes.anos_experiencia, advogados.especialização as casos_Julgados, count(audiencias.id_audiencia) as audiencias_realizadas from juizes 
inner join audiencias on juizes.id_juiz = audiencias.id_juiz
inner join advogados on audiencias.id_advogado = advogados.id_advogado
where juizes.anos_experiencia >= 10
group by juizes.nome_juiz, juizes.anos_experiencia, casos_julgados
having casos_julgados like "%previden%";

-- Encontre os advogados que participaram de audiências para casos com status "pendente".

select advogados.nome_advogado, casos_Juridicos.status_processo from advogados
inner join audiencias on advogados.id_advogado = audiencias.id_advogado
inner join casos_Juridicos on audiencias.id_caso = casos_Juridicos.id_caso
group by advogados.nome_advogado, casos_Juridicos.status_processo
having casos_Juridicos.status_processo like "pend%";

-- Liste todas as partes envolvidas em casos "concluídos", incluindo o tipo (física ou jurídica) e o status do caso.

select partes_envolvidas.nome, partes_envolvidas.tipo, casos_Juridicos.status_processo from partes_envolvidas
inner join casos_Juridicos on partes_envolvidas.id_caso = casos_Juridicos.id_caso
group by partes_envolvidas.nome, partes_envolvidas.tipo, casos_Juridicos.status_processo
having casos_Juridicos.status_processo like "concl%";

-- Encontre os casos onde há mais de uma parte envolvida e o veredicto já foi emitido.

select count(partes_envolvidas.id_parte) as partes_envolvidas_no_processo, casos_Juridicos.descricao, sentencas.veredicto from partes_envolvidas
inner join casos_Juridicos on partes_envolvidas.id_caso = casos_Juridicos.id_caso
inner join sentencas on casos_Juridicos.id_caso = sentencas.id_caso
group by casos_Juridicos.descricao, sentencas.veredicto
having partes_envolvidas_no_processo > 1;

-- Liste os advogados que participaram de casos em que o veredicto foi "culpado".

select advogados.nome_advogado, casos_Juridicos.descricao, sentencas.veredicto from advogados
inner join audiencias on advogados.id_advogado = audiencias.id_advogado
inner join casos_Juridicos on audiencias.id_caso = casos_Juridicos.id_caso
inner join sentencas on casos_Juridicos.id_caso = sentencas.id_caso
group by advogados.nome_advogado, casos_Juridicos.descricao, sentencas.veredicto
having sentencas.veredicto like "culpa%";
